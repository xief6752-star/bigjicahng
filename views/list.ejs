<%- include('header') %>

<style>
.list-page { max-width: 860px; margin: 0 auto; padding: 56px 48px 80px; }
.list-header { margin-bottom: 40px; border-bottom: 2px solid #1a1a1a; padding-bottom: 24px; }
.list-back { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #888; margin-bottom: 16px; display: inline-block; }
.list-back:hover { color: #1a1a1a; }
.list-title { font-size: 2rem; font-weight: 700; letter-spacing: -1px; margin-bottom: 8px; }
.list-count { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #aaa; }

/* Review list */
.rev-list { display: flex; flex-direction: column; gap: 0; }
.rev-item { display: flex; align-items: flex-start; gap: 24px; padding: 28px 0; border-bottom: 1px solid #e0ddd5; transition: opacity .2s; }
.rev-item:hover { opacity: .7; }
.rev-item:last-child { border-bottom: none; }
.rev-score { font-family: 'IBM Plex Mono', monospace; font-size: 2rem; font-weight: 500; color: #1a1a1a; line-height: 1; width: 60px; flex-shrink: 0; padding-top: 4px; }
.rev-info { flex: 1; }
.rev-meta { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.rev-tag { font-family: 'IBM Plex Mono', monospace; font-size: 10px; padding: 2px 8px; border-radius: 3px; font-weight: 500; background: #1a1a1a; color: #fff; }
.tag-red { background: #5a1e1e; }
.tag-brown { background: #6b3a2a; }
.tag-blue { background: #1d3557; }
.rev-date { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #aaa; }
.rev-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 6px; }
.rev-desc { font-size: 14px; color: #666; line-height: 1.6; }

/* Tut / knowledge grid */
.tut-list { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.tut-item { border: 1px solid #e0ddd5; border-radius: 8px; padding: 20px 24px; background: #fff; transition: border-color .2s; display: block; }
.tut-item:hover { border-color: #aaa; }
.tut-plat { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #888; margin-bottom: 8px; }
.tut-name { font-weight: 700; font-size: 15px; color: #1a1a1a; }
.tut-date { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: #bbb; margin-top: 8px; }

@media (max-width: 640px) {
  .list-page { padding: 32px 20px 60px; }
  .tut-list { grid-template-columns: 1fr; }
  .rev-item { flex-direction: column; gap: 12px; }
  .rev-score { font-size: 1.6rem; }
}
</style>

<nav>
  <div class="nav-logo">big博客<span>独立评测</span></div>
  <div class="nav-links">
    <a href="/#reviews">评测</a>
    <a href="/#tutorials">教程</a>
    <a href="/#knowledge">科普</a>
  </div>
</nav>

<div class="list-page">
  <div class="list-header">
    <a href="/" class="list-back">← 返回首页</a>
    <h1 class="list-title"><%= title %></h1>
    <div class="list-count">共 <%= articles.length %> 篇</div>
  </div>

  <% if (type === 'review') { %>
  <div class="rev-list">
    <% articles.forEach(function(article) {
      let tagClass = '';
      if (article.tag && article.tag.includes('避坑')) tagClass = 'tag-red';
      else if (article.tag && article.tag.includes('性价比')) tagClass = 'tag-brown';
      else if (article.tag && article.tag.includes('稳定性')) tagClass = 'tag-blue';
    %>
    <a href="<%= article.slug %>.html" class="rev-item">
      <div class="rev-score"><%= article.score ? article.score.toFixed(1) : '-' %></div>
      <div class="rev-info">
        <div class="rev-meta">
          <span class="rev-tag <%= tagClass %>"><%= article.tag %></span>
          <span class="rev-date"><%= article.date %></span>
        </div>
        <div class="rev-title"><%- article.title %></div>
        <div class="rev-desc"><%= article.subtitle %></div>
      </div>
    </a>
    <% }); %>
  </div>

  <% } else { %>
  <div class="tut-list">
    <% articles.forEach(function(article) { %>
    <a href="<%= article.slug %>.html" class="tut-item">
      <div class="tut-plat"><%= article.tag %></div>
      <div class="tut-name"><%- article.title %> →</div>
      <div class="tut-date"><%= article.date %></div>
    </a>
    <% }); %>
  </div>
  <% } %>
</div>

<%- include('footer') %>
